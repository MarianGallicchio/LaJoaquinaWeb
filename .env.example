# Backoffice La Juaquina — variables de entorno
# En local: copiar a .env | En Vercel: Project Settings > Environment Variables

# IA del chat (opcional; sin clave usa respuestas locales)
GEMINI_API_KEY=

# URL pública del despliegue (para links de Mercado Pago y webhook)
# APP_URL=https://tu-proyecto.vercel.app
# BACKEND_URL=https://tu-proyecto.vercel.app

# Acceso de administradora (REQUERIDO, mínimo 8 caracteres, sin valor por defecto)
ADMIN_EMAIL=admin@lajuaquina.com
ADMIN_PASSWORD=cambia-esta-clave-por-una-propia
# Firma de sesiones (opcional; si se omite deriva de ADMIN_PASSWORD)
# ADMIN_SECRET=otra-clave-larga-distinta

# Base de datos Postgres (REQUERIDO en Vercel para sincronizar admin <-> tienda)
# Crear gratis en https://neon.tech y pegar el connection string:
# DATABASE_URL=postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require
# Vacío = archivo local data/cloud_db.json (solo desarrollo)

# Cobros online con Mercado Pago (opcional; sin esto el botón online avisa y
# la tienda sigue cobrando por transferencia/efectivo coordinando por WhatsApp)
# Credenciales en https://www.mercadopago.com.ar/developers/panel/credentials
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
